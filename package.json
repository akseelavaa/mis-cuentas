{
  "name": "gastos-app",
  "version": "0.1.0",
  "description": "PWA personal de gastos y ahorros (datos solo en el dispositivo)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "vendor": "node -e \"for (const f of ['sql-wasm.js','sql-wasm.wasm']) require('fs').copyFileSync('node_modules/sql.js/dist/'+f, 'vendor/'+f)\"",
    "serve": "npx --yes http-server -p 8080 -c-1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  }
}
